# Copy this file to apps/api/.env and fill in the values.
# .env is gitignored — never commit real secrets.

# API listen port (default: 3000)
PORT=3000

# Interface to bind. Defaults to 127.0.0.1 so only the local reverse proxy can
# reach the app; set to 0.0.0.0 only when the process must accept traffic directly.
# HOST=127.0.0.1

# Set to "production" to serve the built web app (apps/web/dist) from the API
# and enable SSR-lite page rendering. Leave unset in development.
# NODE_ENV=production

# Bearer token for POST/DELETE /api/posts and admin comment deletion.
# Use a long random string, e.g. `openssl rand -hex 32`.
PUBLISH_TOKEN=replace-with-a-long-random-string

# Comma-separated CORS allowlist. In dev this is the Vite origin.
CORS_ORIGINS=http://localhost:5173

# Public origin of the site — used for canonical links, Open Graph URLs,
# sitemap.xml, robots.txt, and RSS item links.
BASE_URL=http://localhost:5173

# Supabase project URL and service-role key (Project Settings → API).
# The service-role key is server-only: it bypasses RLS and must never be
# exposed to the browser or committed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set when running behind a reverse proxy (e.g. Caddy/nginx) so rate limiting
# sees real client IPs. The value is the number of trusted proxy hops.
# TRUST_PROXY=1

# Optional: override the path to the built web index.html
# (defaults to ../../apps/web/dist/index.html relative to apps/api).
# WEB_DIST=/path/to/apps/web/dist/index.html

# Optional: Sentry DSN for server-side error capture (blank = disabled).
# SENTRY_DSN=
